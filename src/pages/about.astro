---
import Layout from '../layouts/Layout.astro'
const worlds = [
  ['With yourself', 'Self-care journals and a free ebook for the quiet minutes you keep for you.', '/shop#journals'],
  ['With your child', 'The Poppy series: stories and activities that help children name big feelings.', '/shop#little-hearts'],
  ['With loved ones', 'Invitations, cards and invitation websites for the days worth gathering for.', '/shop#celebrations'],
]
---
<Layout
  title="About Yuri | Lymira Creations"
  description="Meet Yuri, the creator of Lymira Creations: a former teacher with nearly two decades in classrooms across three continents."
>
  <section class="page-head">
    <div class="wrap yuri-grid">
      <div class="yuri-photo" data-reveal><img src="/assets/brand/yuri.webp" alt="Yuri, creator of Lymira Creations" width="900" height="900" /></div>
      <div class="stack">
        <p class="eyebrow">About</p>
        <h1><span class="script yuri-hi">Hi,</span> I’m Yuri</h1>
        <p class="lede" data-reveal>I’m the creator of Lymira Creations.</p>
        <p data-reveal>I spent nearly two decades teaching across three continents. Some of my greatest teachers were the children who struggled most to navigate the world. They showed me that a gentle story reaches where words alone fall short.</p>
        <p data-reveal>Lymira began with a single creation: Bloom Where You Are, a 30-day journal to help me slow down and find myself again. Poppy followed, then invitations, cards and invitation websites for every celebration worth gathering for.</p>
        <p data-reveal>I art-direct every illustration using AI image tools, then design and assemble each product myself in Canva.</p>
        <div class="btn-row" data-reveal><a class="btn" href="/story">Read my full story <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section class="section band-paper">
    <div class="wrap stack-lg">
      <h2 data-split>Made to Reconnect</h2>
      <div class="steps">
        {worlds.map(([t, d, href]) => (
          <a class="step" href={href} style="text-decoration:none;color:var(--ink)" data-reveal>
            <h3 style="font-size:1.7rem;color:var(--sage-deep)">{t}</h3><p>{d}</p><span class="text-link">Explore</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
