---
// An image area. Shows the real image when its file exists in public/assets,
// otherwise a labelled placeholder in the brand wash.
import { asset } from '../lib/assets.js'
import Dandelion from './Dandelion.astro'
const { file, alt, wash = 'sage', ratio = 'r-45', arch = false, note = 'Mockup to be placed', eager = false, class: cls = '' } = Astro.props
const src = file ? asset(file) : null
const classes = `slot wash-${wash} ${ratio}${arch ? ' arch' : ''} ${cls}`
---
{src ? (
  <div class={classes}><img src={src} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" /></div>
) : (
  <div class={classes} role="img" aria-label={alt}>
    <div class="ph"><Dandelion seeds={18} /><span class="ph-note">{note}</span></div>
  </div>
)}
