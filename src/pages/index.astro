---
import Layout from '../layouts/Layout.astro'
import Slot from '../components/Slot.astro'
import Butterfly from '../components/Butterfly.astro'
import { site, categories, products, reviews } from '../data/content.js'
import { asset, wa } from '../lib/assets.js'

const featuredOrder = ['halloween-party-invitation', 'poppy-and-the-garden-of-feelings', 'bloom-where-you-are', 'silly-goose-baby-shower-invitation', 'poppy-and-the-lonely-hedgehog', 'santas-coming-to-town-website', 'tailor-made-wedding-website', 'cherry-on-top-bachelorette', 'princess-unicorn-birthday-website']
const pick = (slug) => products.find((p) => p.slug === slug)
const featured = featuredOrder.map((s) => products.find((p) => p.slug === s))
const showcase = products.filter((p) => p.showcase)
const kickers = {
  journals: 'Reflect',
  'little-hearts': 'Discover',
  becoming: 'Grow',
  celebrations: 'Celebrate',
}
const ext = { target: '_blank', rel: 'noopener' }
---
<Layout
  bodyClass="page-home"
  title="Lymira Creations | SEL Storybooks & Canva Invitations"
  description="Lymira Creations is a digital products studio: self-care journals, feelings storybooks for kids, editable Canva invitations and cards, and wedding invitation websites. Instant digital download, available worldwide."
>
  <section class="hero hero-garden">
    <img class="hero-girl" src="/assets/brand/hero-girl.webp" alt="" width="689" height="900" />
    <div class="hero-lantern">
      <img src="/assets/brand/hero-lantern.webp" alt="" width="616" height="900" />
      <span class="lantern-glow"></span>
    </div>
    <div class="butterflies" aria-hidden="true">
      <Butterfly tone="gold" /><Butterfly tone="rose" /><Butterfly tone="gold" /><Butterfly tone="blue" /><Butterfly tone="rose" />
    </div>
    <div class="wrap hero-center">
      <img class="hero-mono" src="/assets/brand/monogram.webp" alt="" width="480" height="480" />
      <h1 class="hero-title"><span class="ht-name">Lymira</span><span class="ht-sub">Creations</span></h1>
      <p class="hero-made">Made to <span class="script">Reconnect</span></p>
      <p class="lede" data-intro>{site.subtagline}</p>
      <div class="btn-row" data-intro>
        <a class="btn" href="/shop">Shop the Collection</a>
        <a class="btn btn-ghost" href="/story">Read Her Story</a>
      </div>
    </div>
  </section>

  <section class="section yuri">
    <div class="wrap yuri-grid">
      <div class="yuri-photo" data-reveal><img src="/assets/brand/yuri.webp" alt="Yuri, creator of Lymira Creations" width="900" height="900" loading="lazy" /></div>
      <div class="stack">
        <h2><span class="script yuri-hi">Hi,</span> I’m Yuri</h2>
        <p class="lede" data-reveal>I’m the creator of Lymira Creations. For years I said “I’m done.” Then life finally listened.</p>
        <p data-reveal>After nearly two decades of teaching across three continents, I began making what I wished I’d had: a journal to slow down with, stories that help children name their feelings, and invitations for every celebration worth gathering for.</p>
        <p class="yuri-aside" data-reveal>If those words have been on your lips too, pay attention. They might be leading you somewhere beautiful.</p>
        <div class="btn-row" data-reveal><a class="btn btn-ghost" href="/story">Read my full story <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section class="worlds" aria-labelledby="worlds-title">
    <div class="wrap worlds-head">
      <h2 id="worlds-title" data-split>Four ways to reconnect</h2>
    </div>
    <div class="worlds-track">
      {categories.map((c) => (
        <a class={`world wash-${c.wash}`} href={`/shop#${c.id}`}>
          <div class="world-art"><Slot file={`brand/category-${c.id}`} alt={`${c.name} artwork`} wash={c.wash} arch note="Artwork to be placed" /></div>
          <div class="world-copy">
            <p class="world-kicker">{kickers[c.id]}</p>
            <h3>{c.name}</h3>
            <p>{c.blurb}</p>
            <p class="muted">{c.world}.</p>
            <span class="text-link">Explore</span>
          </div>
        </a>
      ))}
    </div>
    <div class="worlds-progress" aria-hidden="true"><span></span></div>
  </section>

  <section class="section band-sage rail-section">
    <div class="wrap section-head">
      <h2 data-split>Featured creations</h2>
    </div>
    <div class="rail" role="group" aria-roledescription="carousel" aria-label="Featured creations">
      <div class="rail-stage">
        {featured.map((p) => (
          <a class="card rail-card" href={`/products/${p.slug}`} draggable="false">
            <div class="card-media"><img src={asset(`products/${p.slug}`)} alt={p.alt} loading="lazy" decoding="async" draggable="false" /></div>
            <div class="rail-caption">
              <p class="card-meta">{p.type}</p>
              <h3>{p.title}</h3>
              <p class="price">{p.price}</p>
            </div>
          </a>
        ))}
      </div>
      <div class="rail-nav">
        <button type="button" class="rail-btn" data-rail="-1" aria-label="Previous creation">←</button>
        <a class="text-link" href="/shop">See every creation</a>
        <button type="button" class="rail-btn" data-rail="1" aria-label="Next creation">→</button>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack-lg">
      <div class="section-head center" style="text-align:center">
        <p class="eyebrow">Invitation websites</p>
        <h2 data-split>An invitation your guests open like a story</h2>
        <p class="lede" data-reveal>Details, countdown and RSVP in one link. Edit a Canva template yourself, or have yours tailor-made.</p>
      </div>
      <div class="phones">
        {showcase.map((p) => (
          <a class="phone-item" href={`/products/${p.slug}`}>
            <div class="show-card"><Slot file={`products/${p.slug}`} alt={p.alt} wash="blue" ratio="r-11" note="Mockup to be placed" /></div>
            <p class="card-meta">{p.showcase}{p.comingSoon ? ' · Coming soon' : ''}</p>
            <h3>{p.title}</h3>
          </a>
        ))}
      </div>
      <div class="btn-row" style="justify-content:center" data-reveal>
        <a class="btn" href="/shop#invitation-websites">Browse templates <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={wa(site.whatsapp, 'Hello Lymira Creations, I would like price details for a tailor-made invitation website.')} {...ext}>Ask about tailor-made</a>
      </div>
    </div>
  </section>

  <section class="section band-blue">
    <div class="stack-lg">
      <div class="wrap section-head">
        <h2 data-split>Kind words</h2>
      </div>
      <div class="marquee">
        <div class="marquee-track">
          {[0, 1].map((copy) =>
            reviews.map((r) => (
              <figure class="review" aria-hidden={copy === 1 ? 'true' : undefined}>
                <span class="review-mark" aria-hidden="true">“</span>
                <blockquote>{r.quote}</blockquote>
                <figcaption><strong>{r.name}</strong> · {r.about}</figcaption>
              </figure>
            ))
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split" id="ebook">
      <div class="split-media"><div data-parallax><Slot file="products/the-last-time-i-came-last" alt="The Last Time I Came Last ebook cover shown on a tablet" wash="lavender" arch note="Ebook cover to be placed" ratio="r-11" /></div></div>
      <div class="stack">
        <p class="eyebrow">Free ebook</p>
        <h2 data-split>The Last Time I Came Last</h2>
        <p data-reveal>How to stop showing up for everyone except yourself. A short read with a 0 to 10 quiz.</p>
        <p class="muted" data-reveal>It ends with an invitation to a free 15-minute Reconnect Call on WhatsApp.</p>
        <div class="btn-row" data-reveal><a class="btn btn-ghost" href={site.ebook} data-payhip="drQoC" {...ext}>Get the free ebook</a></div>
      </div>
    </div>
  </section>
</Layout>
