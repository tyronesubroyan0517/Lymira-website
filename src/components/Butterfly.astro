---
// A small watercolour-style butterfly. The wings flap in CSS; the flight path is
// set in src/scripts/motion.js.
const { tone = 'gold' } = Astro.props
---
<span class={`butterfly tone-${tone}`}>
  <svg viewBox="0 0 60 48" aria-hidden="true">
    <g class="wing wing-l">
      <path class="upper" d="M30 24C24 8 10 1 4 6C-1 11 6 24 30 24Z" />
      <path class="lower" d="M30 24C18 26 9 32 12 40C15 46 26 40 30 24Z" />
    </g>
    <g class="wing wing-r">
      <path class="upper" d="M30 24C36 8 50 1 56 6C61 11 54 24 30 24Z" />
      <path class="lower" d="M30 24C42 26 51 32 48 40C45 46 34 40 30 24Z" />
    </g>
    <path class="body" d="M30 15V34" />
  </svg>
</span>
