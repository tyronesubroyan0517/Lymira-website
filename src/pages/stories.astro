---
import Layout from '../layouts/Layout.astro'
import Slot from '../components/Slot.astro'
const ext = { target: '_blank', rel: 'noopener' }
const next = [
  ['An anxiety journal', 'The next journal after Bloom Where You Are, with more self-care themes to follow.'],
  ['Birthday invitations', 'Editable Canva invitations for birthdays, in the 3D Pop style.'],
  ['More invitation websites', 'New website templates for more of the days worth gathering for.'],
]
---
<Layout
  title="Stories | Lymira Creations"
  description="Stories, reflections and news from the Lymira Creations studio, including the free ebook The Last Time I Came Last."
>
  <section class="page-head">
    <div class="wrap section-head">
      <p class="eyebrow">Stories</p>
      <h1 data-split>Stories and reflections</h1>
      <p class="lede" data-reveal>Reading from the studio: a free ebook and news of what is being made next. Looking for the journals? They are in the shop.</p>
      <div class="btn-row" data-reveal><a class="btn btn-ghost" href="/shop#journals">Shop Journals & Reflection</a></div>
    </div>
  </section>

  <section class="section-tight">
    <div class="wrap split" id="ebook">
      <div class="split-media"><div data-parallax><Slot file="products/the-last-time-i-came-last" alt="The Last Time I Came Last ebook cover shown on a tablet" wash="lavender" arch note="Ebook cover to be placed" ratio="r-11" /></div></div>
      <div class="stack">
        <p class="eyebrow">Free ebook</p>
        <h2 data-split>The Last Time I Came Last</h2>
        <p data-reveal>How to stop showing up for everyone except yourself. A short read with a 0 to 10 quiz, free to download from the Lymira store.</p>
        <p class="muted" data-reveal>It ends with an invitation to a free 15-minute Reconnect Call on WhatsApp.</p>
        <div class="btn-row" data-reveal><a class="btn" href="https://payhip.com/b/drQoC" data-payhip="drQoC" {...ext}>Get the free ebook <span class="arrow" aria-hidden="true">→</span></a></div>
      </div>
    </div>
  </section>

  <section class="section band-lavender">
    <div class="wrap stack-lg">
      <h2 data-split>Coming next from the studio</h2>
      <div class="steps">
        {next.map(([t, d]) => <div class="step" data-reveal><h3 style="font-size:1.6rem">{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap narrow stack center">
      <h2 data-split>Her Soul Remembered</h2>
      <p data-reveal>Longer stories are shared on our Facebook page.</p>
      <div class="btn-row" data-reveal><a class="btn btn-ghost" href="https://facebook.com/LymiraCreations" {...ext}>Read on Facebook</a></div>
    </div>
  </section>
</Layout>
